# NVIDIA NIM Configuration
# Copy this file to .env and fill in your values
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Security & Auth
JWT_SECRET_KEY=super-secret-key-for-dev-only-change-in-prod-32chars!!
JWT_ISSUER=mcpserver
JWT_AUDIENCE=mcptools
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database & Cache
CONNECTION_STRING=Host=localhost;Port=5432;Database=mcptools;Username=mcp;Password=McpS3cur3Pass!
REDIS_CONNECTION_STRING=localhost:6379
